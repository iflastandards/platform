{
  "name": "@ifla/rdf-converters",
  "version": "0.1.0",
  "description": "RDF to CSV converters with DCTAP support for IFLA Standards Platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "rdf-to-csv": "tsx src/rdf-to-csv.ts",
    "rdf-folder-to-csv": "tsx src/rdf-folder-to-csv.ts",
    "rdf-to-mdx": "tsx src/rdf-to-mdx-pipeline.ts"
  },
  "dependencies": {
    "n3": "*",
    "commander": "*",
    "csv-parse": "*",
    "csv-stringify": "*",
    "jsonld": "*",
    "rdfxml-streaming-parser": "*",
    "glob": "*",
    "chalk": "*",
    "ora": "*",
    "winston": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/jsonld": "*",
    "@typescript-eslint/eslint-plugin": "*",
    "@typescript-eslint/parser": "*",
    "@vitest/coverage-v8": "*",
    "@vitest/ui": "*",
    "eslint": "*",
    "tsx": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "rdf",
    "csv",
    "dctap",
    "ifla",
    "standards",
    "conversion"
  ],
  "author": "IFLA Standards Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iflastandards/platform.git",
    "directory": "tools/typescript/rdf-converters"
  }
}
