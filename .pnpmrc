# IFLA Standards Platform - pnpm Configuration
# Optimized for Nx monorepo with Docusaurus sites and Next.js admin

# Essential Settings
ignore-workspace-root-check=true
prefer-workspace-packages=true
link-workspace-packages=deep

# Dependency Resolution
auto-install-peers=true
dedupe-peer-dependents=true
resolve-peers-from-workspace-root=true

# Performance Optimizations
side-effects-cache=true
use-lockfile-v9=true
# Enable strict peer dependencies for consistency
strict-peer-dependencies=false
# Enable cache for node_modules linking
modules-cache-max-age=7776000
# Use hard links when possible for faster installs
hardlink-local-packages=true

# Hoisting Configuration for Better Compatibility
# Docusaurus-related packages
public-hoist-pattern[]=*docusaurus*
public-hoist-pattern[]=@mdx-js/*
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=webpack*
public-hoist-pattern[]=*loader

# Next.js and React ecosystem
public-hoist-pattern[]=*next*
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=react-is

# MUI and styling
public-hoist-pattern[]=@mui/*
public-hoist-pattern[]=@emotion/*
public-hoist-pattern[]=clsx

# Development tools
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=typescript
public-hoist-pattern[]=@types/*

# Testing tools
public-hoist-pattern[]=*vitest*
public-hoist-pattern[]=*playwright*
public-hoist-pattern[]=*jest*
public-hoist-pattern[]=@testing-library/*

# Build tools
public-hoist-pattern[]=*vite*
public-hoist-pattern[]=*nx*
public-hoist-pattern[]=tsup

# Store Configuration (Optimized for modern hardware)
store-dir=~/.pnpm-store
virtual-store-dir=.pnpm
use-running-store-server=false

# Network Settings
network-concurrency=32

# Additional hoist patterns for common dependencies
public-hoist-pattern[]=*supabase*
public-hoist-pattern[]=*clerk*
public-hoist-pattern[]=*refine*
public-hoist-pattern[]=*antd*
public-hoist-pattern[]=*zod*

# Logging
loglevel=warn
reporter=default

# Lockfile
lockfile=true
# frozen-lockfile=false  # Enable this in CI via env var: CI=true
