{
  "name": "@ifla/fixtures",
  "version": "0.1.0",
  "description": "Static JSON fixtures and mock data for MSW and testing",
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./jobs": {
      "import": "./dist/jobs.js",
      "require": "./dist/jobs.js",
      "types": "./dist/jobs.d.ts"
    },
    "./vocabularies": {
      "import": "./dist/vocabularies.js",
      "require": "./dist/vocabularies.js",
      "types": "./dist/vocabularies.d.ts"
    },
    "./rdf-builds.json": "./rdf-builds.json",
    "./clerk-users.json": "./clerk-users.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-fixtures.ts"
  },
  "dependencies": {
    "@ifla/contracts": "workspace:*",
    "msw": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "rimraf": "*",
    "tsup": "*",
    "tsx": "*",
    "typescript": "*"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
