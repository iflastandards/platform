{
  "name": "@ifla/clients",
  "version": "0.1.0",
  "description": "Typed API client wrappers for external services and databases",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./supabase": {
      "types": "./dist/supabase/index.d.ts",
      "import": "./dist/supabase/index.js",
      "require": "./dist/supabase/index.js"
    },
    "./github": {
      "types": "./dist/github/index.d.ts",
      "import": "./dist/github/index.js",
      "require": "./dist/github/index.js"
    }
  },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "build": "tsup",
    "prebuild": "pnpm codegen",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@ifla/contracts": "workspace:*",
    "@octokit/graphql": "*",
    "@octokit/rest": "*",
    "@supabase/supabase-js": "*",
    "graphql": "^16.11.0",
    "zod": "*",
    "zod-validation-error": "*"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "*",
    "@graphql-codegen/client-preset": "*",
    "@octokit/graphql-schema": "*",
    "@types/node": "*",
    "rimraf": "*",
    "tsup": "*",
    "typescript": "*"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
