# Environment Variables Template
# Copy this file to .env.local and fill in your values

# ============================================
# CORE CONFIGURATION
# ============================================

# Enable mock mode for offline development (true/false)
NEXT_PUBLIC_USE_MOCK=true

# API base URL (only needed when USE_MOCK=false)
NEXT_PUBLIC_API_BASE="https://api.example.com"

# ============================================
# AUTHENTICATION (Clerk)
# ============================================

# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ============================================
# DATABASE (Supabase)
# ============================================

# Get these from https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ============================================
# EXTERNAL SERVICES
# ============================================

NEXT_PUBLIC_EXTERNAL_API_URL="https://api.external-service.com"
EXTERNAL_API_KEY="your_api_key_here"

# ============================================
# FEATURE FLAGS
# ============================================

# Enable debug logging in console (true/false)
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=false

# Enable React DevTools (true/false)
NEXT_PUBLIC_ENABLE_DEVTOOLS=false

# ============================================
# MOCK CONFIGURATION (Optional)
# ============================================

# Delay for mock responses in milliseconds
NEXT_PUBLIC_MOCK_DELAY_MS=100

# Rate of random errors for testing (0-1)
NEXT_PUBLIC_MOCK_ERROR_RATE=0

# ============================================
# MONITORING (Optional)
# ============================================

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# Analytics
NEXT_PUBLIC_ANALYTICS_ID="G-..."

# ============================================
# ENVIRONMENT-SPECIFIC FILES
# ============================================
# 
# .env.local       - Local development with mocks (gitignored)
# .env.development - Development/staging environment (gitignored)
# .env.production  - Production environment (gitignored)
# .env.example     - This template file (committed)
#
# Next.js loads environment files in this order:
# 1. .env.production or .env.development (based on NODE_ENV)
# 2. .env.local (always, except in test environment)
# 3. .env
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Server-only variables (without prefix) are only available in API routes.
# ============================================