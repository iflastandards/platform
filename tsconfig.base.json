{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "types": [
      "node",
      "react",
      "docusaurus-plugin-sass",
      "@docusaurus/theme-classic",
      "@docusaurus/types",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@ifla/contracts": ["./packages/contracts/index.ts"],
      "@ifla/contracts/*": ["./packages/contracts/*"],
      "@ifla/fixtures": ["./packages/fixtures/src/index.ts"],
      "@ifla/fixtures/*": ["./packages/fixtures/src/*"],
      "@ifla/theme": ["./packages/theme/src/index.ts"],
      "@ifla/theme/*": ["./packages/theme/src/*"]
    }
  },
  "include": [
    "src",
    ".docusaurus",
    "packages",
    "portal/src",
    "standards/*/src",
    "**/*.ts",
    "**/*.tsx",
    "*.d.ts",
    "plugins",
    "types/**/*.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "static",
    "coverage",
    "tools",
    "apps",
    "scripts",
    "supabase",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/tests/**/*",
    "**/test/**/*",
    "**/__tests__/**/*",
    "**/e2e/**/*",
    "**/.next/**/*",
    "**/dist/**/*",
    "**/.docusaurus/**/*",
    "**/coverage/**/*",
    "**/.nx/**/*",
    ".idea/**/*",
    ".vscode/**/*"
  ],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node10"
    }
  }
}
