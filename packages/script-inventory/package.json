{
  "name": "@ifla/script-inventory",
  "version": "0.0.0",
  "description": "Self-maintaining script inventory system with auto-registration and documentation enforcement",
  "private": true,
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "script-inventory": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "api:dev": "tsx src/api/server.ts",
    "cli:analyze": "tsx src/cli/commands/analyze.ts",
    "cli:query": "tsx src/cli/commands/query.ts",
    "register": "tsx src/cli/commands/register.ts",
    "validate": "tsx src/cli/commands/validate.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.mjs",
      "require": "./dist/cli/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.mjs",
      "require": "./dist/api/index.js"
    }
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "glob": "^10.3.10",
    "helmet": "^7.0.0",
    "mime-types": "^2.1.35",
    "simple-statistics": "^7.8.3",
    "sqlite3": "^5.1.6",
    "ws": "^8.14.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.4",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/mime-types": "^2.1.3",
    "@types/node": "^20.8.0",
    "@types/simple-statistics": "^7.3.0",
    "@types/sqlite3": "^3.1.9",
    "@types/supertest": "^2.0.16",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.52.0",
    "supertest": "^6.3.4",
    "tsup": "^8.0.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "script-inventory",
    "code-analysis",
    "documentation",
    "developer-tools",
    "ifla"
  ],
  "author": "IFLA Standards Team",
  "license": "MIT"
}