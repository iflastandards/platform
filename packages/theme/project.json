{
  "name": "@ifla/theme",
  "root": "packages/theme",
  "sourceRoot": "packages/theme/src",
  "projectType": "library",
  "tags": ["library", "theme", "scope:theme"],
  "targets": {
    "build:tsc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --project tsconfig.declarations.json",
        "cwd": "packages/theme"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./build.sh",
        "cwd": "packages/theme"
      },
      "outputs": ["{projectRoot}/dist"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsup.config.ts",
        "{projectRoot}/tsconfig.declarations.json",
        "{projectRoot}/package.json",
        "!{projectRoot}/**/*.test.*",
        "!{projectRoot}/**/*.spec.*",
        "!{projectRoot}/**/*.md",
        "!{projectRoot}/README.md",
        {
          "dependentTasksOutputFiles": "packages/contracts/dist/**/*",
          "transitive": false
        }
      ],
      "dependsOn": [
        {
          "target": "build",
          "projects": ["@ifla/contracts"],
          "params": "forward"
        }
      ],
      "cache": true
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "config": "{workspaceRoot}/vitest.config.nx.ts",
        "passWithNoTests": true
      },
      "cache": true,
      "inputs": ["testInputs", "^testInputs"],
      "outputs": ["{projectRoot}/coverage", "{projectRoot}/test-results"]
    },
    "test:unit": {
      "executor": "@nx/vite:test",
      "options": {
        "config": "{workspaceRoot}/vitest.config.nx.ts",
        "exclude": ["**/scripts/**", "**/deployment/**"],
        "passWithNoTests": true
      },
      "cache": true,
      "inputs": ["testInputs", "sharedGlobals"],
      "outputs": ["{projectRoot}/coverage", "{projectRoot}/test-results"]
    },
    "test:integration": {
      "executor": "@nx/vite:test",
      "options": {
        "config": "{workspaceRoot}/vitest.config.integration.ts",
        "passWithNoTests": true
      },
      "cache": true,
      "inputs": ["testInputs", "sharedGlobals"],
      "outputs": ["{projectRoot}/coverage", "{projectRoot}/test-results"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/theme/src/**/*.{ts,tsx,js,jsx}",
          "packages/theme/*.{ts,tsx,js,jsx}"
        ],
        "quiet": true
      },
      "inputs": ["default"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/theme"
      },
      "cache": true,
      "dependsOn": [
        {
          "target": "build",
          "projects": ["@ifla/contracts"]
        }
      ],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/**/*.{ts,tsx}",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.json",
        "!{projectRoot}/dist/**/*",
        "!{projectRoot}/**/*.test.*"
      ]
    }
  }
}
