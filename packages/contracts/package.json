{
  "name": "@ifla/contracts",
  "version": "0.1.0",
  "description": "Single source of truth for all data shapes, schemas, and API contracts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "require": "./dist/schemas/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "generate:types": "pnpm --filter=@ifla/contracts run codegen:openapi",
    "codegen:openapi": "tsx ../../../tools/codegen/generate-types.ts"
  },
  "dependencies": {
    "zod": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "rimraf": "*",
    "tsup": "*",
    "tsx": "*",
    "typescript": "*"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
