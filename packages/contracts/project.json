{
  "name": "@ifla/contracts",
  "root": "packages/contracts",
  "sourceRoot": "packages/contracts/src",
  "projectType": "library",
  "tags": ["library", "contracts", "scope:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/schemas/**/*",
        "{projectRoot}/types/**/*",
        "{projectRoot}/index.ts",
        "{projectRoot}/tsup.config.ts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/package.json",
        "!{projectRoot}/**/*.test.*",
        "!{projectRoot}/**/*.spec.*",
        "!{projectRoot}/**/*.md",
        "!{projectRoot}/README.md"
      ],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [],
      "cache": true
    },
    "clean": {
      "executor": "nx:run-script",
      "options": {
        "script": "clean"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/contracts/src/**/*.{ts,tsx,js,jsx}",
          "packages/contracts/*.{ts,tsx,js,jsx}"
        ],
        "quiet": true
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/**/*.{ts,tsx,js,jsx}",
        "{workspaceRoot}/eslint.config.mjs",
        "!{projectRoot}/dist/**/*",
        "!{projectRoot}/node_modules/**/*"
      ],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/contracts"
      },
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/**/*.ts",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.json",
        "!{projectRoot}/dist/**/*",
        "!{projectRoot}/**/*.test.*"
      ]
    }
  }
}
