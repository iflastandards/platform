{
  "openapi": "3.0.3",
  "info": {
    "title": "IFLA Admin API",
    "description": "API endpoints for the IFLA Standards Admin Portal",
    "version": "1.0.0",
    "contact": {
      "name": "IFLA Standards Team",
      "email": "support@iflastandards.info"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001/api",
      "description": "Local development server"
    },
    {
      "url": "https://admin-iflastandards-preview.onrender.com/api",
      "description": "Preview environment"
    },
    {
      "url": "https://admin.iflastandards.info/api",
      "description": "Production environment"
    }
  ],
  "components": {
    "schemas": {
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "rdf_build",
              "csv_to_rdf",
              "validate_rdf",
              "translation_sync",
              "vocabulary_import",
              "export_rdf",
              "validate_terms",
              "generate_docs"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "success",
              "failed",
              "cancelled"
            ]
          },
          "description": {
            "type": "string"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "outputUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "RdfBuild": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "namespaceId": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "turtle",
              "json-ld",
              "n-triples",
              "rdf-xml"
            ]
          },
          "includeDeprecated": {
            "type": "boolean"
          },
          "includeAlternates": {
            "type": "boolean"
          },
          "baseUri": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "building",
              "ready",
              "failed"
            ]
          },
          "lastBuildAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "outputUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "namespaceId",
          "format",
          "status"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "securitySchemes": {
      "ClerkAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Clerk authentication token"
      }
    }
  },
  "security": [
    {
      "ClerkAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check endpoint",
        "description": "Returns the health status of the API",
        "tags": [
          "System"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/jobs": {
      "get": {
        "summary": "List jobs",
        "description": "Get a paginated list of jobs with optional filtering",
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "success",
                "failed",
                "cancelled"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Job"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new job",
        "description": "Queue a new background job for processing",
        "tags": [
          "Jobs"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "rdf_build",
                      "csv_to_rdf",
                      "vocabulary_import",
                      "export_rdf"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "object"
                  }
                },
                "required": [
                  "type",
                  "description"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/jobs/{id}": {
      "get": {
        "summary": "Get job by ID",
        "description": "Retrieve details of a specific job",
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/rdf-builds": {
      "get": {
        "summary": "List RDF builds",
        "description": "Get a list of RDF build configurations",
        "tags": [
          "RDF"
        ],
        "responses": {
          "200": {
            "description": "List of RDF builds",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RdfBuild"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create RDF build",
        "description": "Create a new RDF build configuration",
        "tags": [
          "RDF"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RdfBuild"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "RDF build created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RdfBuild"
                }
              }
            }
          }
        }
      }
    },
    "/validate-csv": {
      "post": {
        "summary": "Validate CSV file",
        "description": "Validate a CSV file for vocabulary import",
        "tags": [
          "Validation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "row": {
                            "type": "integer"
                          },
                          "column": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "System",
      "description": "System health and status endpoints"
    },
    {
      "name": "Jobs",
      "description": "Background job management"
    },
    {
      "name": "RDF",
      "description": "RDF data operations"
    },
    {
      "name": "Validation",
      "description": "Data validation endpoints"
    }
  ]
}