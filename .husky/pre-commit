#!/usr/bin/env sh
# always execute from repository root
cd "$(git rev-parse --show-toplevel)" || exit

# Force non-interactive behavior and fail fast
export CI=1
set -e

# Group 3: Pre-commit tests (Fast feedback for commits)
# Uses the new organized test structure
echo "🔍 Running Group 3: Pre-commit tests..."

# First, format staged files with Prettier via Nx
echo "✨ Formatting staged files..."
npx nx format:write --uncommitted

# Validate YAML files
echo "📝 Validating YAML files..."
node scripts/validate-yaml.js

echo "✅ YAML validation passed!"

# Next, validate test file tagging and naming conventions
echo "📋 Validating test file tagging..."
node scripts/validate-test-tagging.js

echo "✅ Test tagging validation passed!"

# Use the smart pre-commit path for intelligent validation based on changes
echo "🧠 Running smart pre-commit checks (intelligently optimized based on changes)"
pnpm test:pre-commit:smart

echo "✅ Group 3 pre-commit tests passed!"
