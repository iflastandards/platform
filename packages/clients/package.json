{
  "name": "@ifla/clients",
  "version": "0.1.0",
  "description": "Typed API client wrappers for external services and databases",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./supabase": {
      "import": "./dist/supabase/index.js",
      "require": "./dist/supabase/index.js",
      "types": "./dist/supabase/index.d.ts"
    },
    "./github": {
      "import": "./dist/github/index.js",
      "require": "./dist/github/index.js",
      "types": "./dist/github/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ifla/contracts": "workspace:*",
    "@supabase/supabase-js": "*",
    "@octokit/rest": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "rimraf": "*",
    "tsup": "*",
    "typescript": "*"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
